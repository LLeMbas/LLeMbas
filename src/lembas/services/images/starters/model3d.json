{
  "1": {
    "inputs": {
      "ckpt_name": "hunyuan3d-dit-v2.safetensors"
    },
    "class_type": "ImageOnlyCheckpointLoader",
    "_meta": {
      "title": "Load 3D model"
    }
  },
  "2": {
    "inputs": {
      "image": "{{image}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "The picture to model"
    }
  },
  "3": {
    "inputs": {
      "clip_vision": [
        "1",
        1
      ],
      "image": [
        "2",
        0
      ],
      "crop": "none"
    },
    "class_type": "CLIPVisionEncode",
    "_meta": {
      "title": "CLIPVisionEncode"
    }
  },
  "4": {
    "inputs": {
      "clip_vision_output": [
        "3",
        0
      ]
    },
    "class_type": "Hunyuan3Dv2Conditioning",
    "_meta": {
      "title": "Hunyuan3Dv2Conditioning"
    }
  },
  "5": {
    "inputs": {
      "resolution": 3072,
      "batch_size": 1
    },
    "class_type": "EmptyLatentHunyuan3Dv2",
    "_meta": {
      "title": "EmptyLatentHunyuan3Dv2"
    }
  },
  "6": {
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 1.0
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "ModelSamplingAuraFlow"
    }
  },
  "7": {
    "inputs": {
      "seed": "{{seed}}",
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": [
        "6",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "4",
        1
      ],
      "latent_image": [
        "5",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "8": {
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "1",
        2
      ],
      "num_chunks": 8000,
      "octree_resolution": "{{mesh_quality}}"
    },
    "class_type": "VAEDecodeHunyuan3D",
    "_meta": {
      "title": "VAEDecodeHunyuan3D"
    }
  },
  "9": {
    "inputs": {
      "voxel": [
        "8",
        0
      ],
      "threshold": 0.6
    },
    "class_type": "VoxelToMeshBasic",
    "_meta": {
      "title": "VoxelToMeshBasic"
    }
  },
  "10": {
    "inputs": {
      "mesh": [
        "9",
        0
      ],
      "filename_prefix": "lembas/model"
    },
    "class_type": "SaveGLB",
    "_meta": {
      "title": "SaveGLB"
    }
  }
}
