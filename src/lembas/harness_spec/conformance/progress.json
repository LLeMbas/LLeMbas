    {
      "about": "Queued, nothing more known.",
      "progress": {
        "phase": "queued",
        "since": 1762790400000
      },
      "now": 1762790405000,
      "expect": {
        "text": "Queued",
        "line": "Queued · 5s"
      }
    },
    {
