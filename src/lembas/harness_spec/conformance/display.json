    },
    {
      "about": "A finished call: tenths under a minute.",
      "show": "duration",
      "state": "done",
      "ms": 412,
      "expect": {
        "duration": "0.4s"
      }
    },
    {
      "about": "Seconds.",
      "show": "duration",
      "state": "done",
      "ms": 8449,
      "expect": {
        "duration": "8.4s"
      }
    },
    {
      "about": "Just under a minute.",
      "show": "duration",
      "state": "failed",
