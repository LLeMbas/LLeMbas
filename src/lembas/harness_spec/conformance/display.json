    {
      "about": "A command that failed shows its exit code.",
      "show": "facts",
      "block": "shell",
      "exit": 2,
      "expect": {
        "facts": [
          "exit 2"
        ]
      }
    },
    {
      "about": "A command that succeeded shows none.",
      "show": "facts",
      "block": "shell",
      "exit": 0,
      "expect": {
        "facts": []
      }
    },
    {
      "about": "A search shows its hits.",
      "show": "facts",
      "block": "search",
      "hits": 14,
