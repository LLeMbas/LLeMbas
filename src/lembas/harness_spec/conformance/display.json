{
  "about": "Display (display.md, spec 3.7.0), in the plain number format. `show` says what is asked. `title`: a call's `args` (and its `tool`, for the reader) — expect `title`, the one short title (display.md §1), or null where the call has none. `duration`: a call's `state` and `ms` — expect `duration` as drawn beside the title (§2), or null. `change`: a unified `diff` — expect `added`, `removed` counted by its hunks, and `text` (loop.json display.change). `facts`: a finished call's `block` with its `diff`, `exit` or `hits` — expect `facts`, the texts after the title in order. `end`: a turn's last `progress` (or null) — expect `line`, the line that stays on the finished reply (§4), or null. `drawn`: a `block` — whether it is drawn as a call (§3). LLeMbas: services/display.py; CLI: session/display.ts.",
  "cases": [
    {
      "about": "A command is its own title.",
      "show": "title",
      "tool": "bash",
      "args": {
        "command": "bun test",
        "description": "Run the tests"
      },
      "expect": {
        "title": "bun test"
      }
    },
    {
      "about": "Only the first line of a command.",
      "show": "title",
      "tool": "bash",
      "args": {
        "command": "  cd src &&\n  make  "
      },
      "expect": {
        "title": "cd src &&"
      }
    },
    {
      "about": "A search is titled by its pattern, not where it looks.",
      "show": "title",
      "tool": "grep",
      "args": {
        "pattern": "TODO\\(",
        "path": "src"
      },
      "expect": {
        "title": "TODO\\("
      }
    },
    {
      "about": "A file search likewise.",
      "show": "title",
      "tool": "glob",
      "args": {
        "pattern": "**/*.ts",
        "path": "src/tui"
      },
      "expect": {
        "title": "**/*.ts"
      }
    },
    {
      "about": "A read by its path.",
      "show": "title",
      "tool": "read",
      "args": {
        "path": "src/app.ts",
        "offset": 120
      },
      "expect": {
        "title": "src/app.ts"
      }
    },
    {
      "about": "A listing with no path has no title.",
      "show": "title",
      "tool": "list",
      "args": {
        "depth": 2
      },
      "expect": {
        "title": null
      }
    },
    {
      "about": "An edit by its path.",
      "show": "title",
      "tool": "edit",
      "args": {
        "path": "README.md",
        "old": "a",
        "new": "b"
      },
      "expect": {
        "title": "README.md"
      }
    },
    {
      "about": "A web search by its query.",
      "show": "title",
      "tool": "web_search",
      "args": {
        "query": "opentui extmarks",
        "max_results": 5
      },
      "expect": {
        "title": "opentui extmarks"
      }
    },
    {
      "about": "A fetch by its address.",
      "show": "title",
      "tool": "web_fetch",
      "args": {
        "url": "https://example.org/docs"
      },
      "expect": {
        "title": "https://example.org/docs"
      }
    },
    {
      "about": "A task by its description, not its prompt.",
      "show": "title",
      "tool": "task",
      "args": {
        "description": "Find the callers",
        "prompt": "Look through src/ for every caller of load() and list them."
      },
      "expect": {
        "title": "Find the callers"
      }
    },
    {
      "about": "A subagent by its name.",
      "show": "title",
      "tool": "team_add",
      "args": {
        "name": "Reviewer",
        "role": "reviews the change",
        "task": "Read the diff."
      },
      "expect": {
        "title": "Reviewer"
      }
    },
    {
      "about": "A phone action by its summary, whatever else it carries.",
      "show": "title",
      "tool": "phone_action",
      "args": {
        "action": "open_url",
        "summary": "Open the timetable",
        "url": "https://example.org/t"
      },
      "expect": {
        "title": "Open the timetable"
      }
    },
    {
      "about": "Python by the first line of its code.",
      "show": "title",
      "tool": "python",
      "args": {
        "code": "import math\nprint(math.pi)"
      },
      "expect": {
        "title": "import math"
      }
    },
    {
      "about": "A question by its headers.",
      "show": "title",
      "tool": "ask_user",
      "args": {
        "why": "The schema is open.",
        "questions": [
          {
            "header": "Database",
            "question": "Which one?",
            "options": []
          },
          {
            "header": "Cache",
            "question": "Which cache?",
            "options": []
          }
        ]
      },
      "expect": {
        "title": "Database · Cache"
      }
    },
    {
      "about": "A patch by the files it names.",
      "show": "title",
      "tool": "apply_patch",
      "args": {
        "patch": "*** Begin Patch\n*** Update File: src/a.ts\n@@\n-x\n+y\n*** Add File: docs/b.md\n+hello\n*** Delete File: old.txt\n*** End Patch"
      },
      "expect": {
        "title": "src/a.ts, docs/b.md, old.txt"
      }
    },
    {
      "about": "A unified diff as a patch: the +++ paths, without b/ and without /dev/null.",
      "show": "title",
      "tool": "apply_patch",
      "args": {
        "patch": "--- a/src/a.ts\n+++ b/src/a.ts\n@@ -1 +1 @@\n-x\n+y\n--- a/gone.txt\n+++ /dev/null\n@@ -1 +0,0 @@\n-bye\n"
      },
      "expect": {
        "title": "src/a.ts"
      }
    },
    {
      "about": "A patch that names nothing falls back to its path.",
      "show": "title",
      "tool": "apply_patch",
      "args": {
        "patch": "@@ -1 +1 @@\n-x\n+y\n",
        "path": "src/a.ts"
      },
      "expect": {
        "title": "src/a.ts"
      }
    },
    {
