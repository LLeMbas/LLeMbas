    },
    {
      "about": "A running call shows none.",
      "show": "duration",
      "state": "running",
      "ms": 5000,
      "expect": {
        "duration": null
      }
    },
    {
      "about": "A stored call whose time was not kept shows none.",
      "show": "duration",
      "state": "done",
      "expect": {
        "duration": null
      }
    },
    {
      "about": "One line changed.",
      "show": "change",
      "diff": "--- a/a.txt\n+++ b/a.txt\n@@ -1,3 +1,3 @@\n one\n-two\n+2\n three\n",
      "expect": {
        "added": 1,
        "removed": 1,
        "text": "+1 −1"
      }
    },
    {
      "about": "Headers without a/ and b/ are still headers.",
      "show": "change",
      "diff": "Index: a.txt\n===================================================================\n--- a.txt\n+++ a.txt\n@@ -1,2 +1,3 @@\n one\n+one and a half\n two\n",
      "expect": {
        "added": 1,
        "removed": 0,
        "text": "+1 −0"
      }
    },
    {
      "about": "A removed line that begins with `-- ` and an added one that begins with `++ ` are lines, not headers.",
      "show": "change",
      "diff": "--- a/q.sql\n+++ b/q.sql\n@@ -1,3 +1,3 @@\n select 1;\n--- the old comment\n+++ the new one\n select 2;\n",
      "expect": {
        "added": 1,
        "removed": 1,
        "text": "+1 −1"
      }
    },
    {
      "about": "A new file.",
      "show": "change",
      "diff": "--- /dev/null\n+++ b/new.txt\n@@ -0,0 +1,2 @@\n+a\n+b\n",
      "expect": {
        "added": 2,
        "removed": 0,
        "text": "+2 −0"
      }
    },
    {
      "about": "A hunk header without counts means one line each.",
      "show": "change",
      "diff": "--- a/x\n+++ b/x\n@@ -1 +1 @@\n-a\n+b\n",
      "expect": {
        "added": 1,
        "removed": 1,
        "text": "+1 −1"
      }
    },
    {
      "about": "No newline at end of file counts for nothing.",
      "show": "change",
      "diff": "--- a/x\n+++ b/x\n@@ -1 +1 @@\n-a\n\\ No newline at end of file\n+b\n\\ No newline at end of file\n",
      "expect": {
        "added": 1,
        "removed": 1,
        "text": "+1 −1"
      }
    },
    {
      "about": "Two files add up.",
      "show": "change",
      "diff": "diff --git a/a b/a\n--- a/a\n+++ b/a\n@@ -1 +1,2 @@\n a\n+b\ndiff --git a/c b/c\n--- a/c\n+++ b/c\n@@ -1,2 +1 @@\n c\n-d\n",
      "expect": {
        "added": 1,
        "removed": 1,
        "text": "+1 −1"
      }
    },
    {
      "about": "No diff, nothing changed.",
      "show": "change",
      "diff": "",
      "expect": {
        "added": 0,
        "removed": 0,
        "text": "+0 −0"
      }
    },
    {
      "about": "An edit shows its change.",
      "show": "facts",
      "block": "edit",
      "diff": "--- a/x\n+++ b/x\n@@ -1 +1,2 @@\n-a\n+b\n+c\n",
      "expect": {
        "facts": [
          "+2 −1"
