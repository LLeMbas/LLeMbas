    {
      "about": "Failed, with the error.",
      "show": "end",
      "progress": {
        "phase": "failed",
        "since": 1762790400000,
        "reason": "502 Bad Gateway"
      },
      "now": 1762790460000,
      "expect": {
        "line": "Failed: 502 Bad Gateway"
      }
    },
    {
      "about": "A reply that finished shows nothing.",
      "show": "end",
      "progress": null,
      "now": 1762790460000,
      "expect": {
        "line": null
      }
    },
    {
      "about": "A phase that is not an end shows nothing on the reply.",
      "show": "end",
      "progress": {
        "phase": "writing",
        "since": 1762790400000
      },
      "now": 1762790460000,
      "expect": {
        "line": null
      }
    },
    {
      "about": "A plan change is not drawn as a call.",
      "show": "drawn",
      "block": "plan",
      "expect": {
        "drawn": false
      }
    },
    {
      "about": "Nor a hidden tool.",
      "show": "drawn",
      "block": "hidden",
      "expect": {
        "drawn": false
      }
    },
    {
      "about": "A command is.",
      "show": "drawn",
      "block": "shell",
      "expect": {
        "drawn": true
      }
    },
    {
      "about": "A tool nobody knows is the generic block.",
      "show": "drawn",
      "expect": {
        "drawn": true
      }
    }
  ]
}
