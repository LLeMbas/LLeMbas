{
  "about": "Spec 3.9.0 (interactive.md): interactive-only models. `models`: the served models in the list's order, each `{id, interactive_only?}` (absent: false). `kind: twin` — `model` → the id of the same model on a connection that is not interactive-only (another id with the same part after its first `/`, the first in order), or null. `kind: background` — where a background call that would use `model` goes. `call`: `title`, `compaction` (the person asked) or `auto_compaction`; `defaults`: the defaults to try after the twin, in order (a device: its global `model` setting, then the instance's default; the server: the instance's default) — one that is not listed or is interactive-only is passed over. → `{model}` (the model asked: itself, the twin or a default), `{skip: true}`, or `{refused}` with loop.json interactive.texts.compact. `kind: scheduled` — scheduled work on `model` (a run's session, its subagent, a one-shot run with nobody at it): → `{run: true}`, or `{refused}` with interactive.texts.scheduled, `{{model}}` the id. The server's twin also has to be one the person may use in the chat's data group, which no case here turns on. CLI: src/provider/interactive.ts; LLeMbas: services/interactive.py.",
  "cases": [
    {
      "about": "The plan's pay-as-you-go twin: the same model under another provider.",
      "kind": "twin",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "payg/qwen3-coder"
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "expect": "payg/qwen3-coder"
    },
    {
      "about": "No other provider serves it.",
      "kind": "twin",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "expect": null
    },
    {
      "about": "A twin that is itself interactive-only is none.",
      "kind": "twin",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "other-plan/qwen3-coder",
          "interactive_only": true
        }
      ],
      "expect": null
    },
    {
      "about": "The part after the first slash is compared whole: a longer name is another model.",
      "kind": "twin",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "payg/qwen3-coder-plus"
        },
        {
          "id": "payg/org/qwen3-coder"
        }
      ],
      "expect": null
    },
    {
      "about": "The first in the list's order.",
      "kind": "twin",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "b/qwen3-coder"
        },
        {
          "id": "a/qwen3-coder"
        }
      ],
      "expect": "b/qwen3-coder"
    },
    {
      "about": "A model that is not interactive-only is asked itself, as before.",
      "kind": "background",
      "call": "title",
      "model": "deepseek/deepseek-flash",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "payg/qwen3-coder"
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "defaults": [
        "payg/qwen3-coder"
      ],
      "expect": {
        "model": "deepseek/deepseek-flash"
      }
    },
    {
      "about": "A title for a session on a plan's model goes to the twin.",
      "kind": "background",
      "call": "title",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "payg/qwen3-coder"
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "defaults": [
        "deepseek/deepseek-flash"
      ],
      "expect": {
        "model": "payg/qwen3-coder"
      }
    },
    {
      "about": "No twin: the default that is not interactive-only.",
      "kind": "background",
      "call": "compaction",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "defaults": [
        "deepseek/deepseek-flash"
      ],
      "expect": {
        "model": "deepseek/deepseek-flash"
      }
    },
    {
      "about": "The first default is interactive-only too, the second is not.",
      "kind": "background",
      "call": "auto_compaction",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "plan/qwen3-max",
          "interactive_only": true
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "defaults": [
        "plan/qwen3-max",
        "deepseek/deepseek-flash"
      ],
      "expect": {
        "model": "deepseek/deepseek-flash"
      }
    },
    {
      "about": "A default the list does not have is passed over.",
      "kind": "background",
      "call": "title",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "plan/qwen3-max",
          "interactive_only": true
        }
      ],
      "defaults": [
        "gone/model"
      ],
      "expect": {
        "skip": true
      }
    },
    {
      "about": "Nowhere to go: a title is skipped.",
      "kind": "background",
      "call": "title",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "plan/qwen3-max",
          "interactive_only": true
        }
      ],
      "defaults": [
        "plan/qwen3-max"
      ],
      "expect": {
        "skip": true
      }
    },
    {
      "about": "Nowhere to go: compaction the person asked for is refused in words.",
      "kind": "background",
      "call": "compaction",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "plan/qwen3-max",
          "interactive_only": true
        }
      ],
      "defaults": [
        "plan/qwen3-coder"
      ],
      "expect": {
        "refused": "This chat's model is on a connection for interactive use only, and compacting is background work its provider's terms do not allow. It needs the same model on a pay-as-you-go connection, or a default model that is not interactive-only."
      }
    },
    {
      "about": "Nowhere to go: automatic compaction is skipped and the turn goes on.",
      "kind": "background",
      "call": "auto_compaction",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "plan/qwen3-max",
          "interactive_only": true
        }
      ],
      "defaults": [],
      "expect": {
        "skip": true
      }
    },
    {
      "about": "A scheduled run on a pay-as-you-go model.",
      "kind": "scheduled",
      "model": "payg/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "payg/qwen3-coder"
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "expect": {
        "run": true
      }
    },
    {
      "about": "A scheduled run whose model is interactive-only fails with the sentence — never quietly on its twin.",
      "kind": "scheduled",
      "model": "plan/qwen3-coder",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "payg/qwen3-coder"
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "expect": {
        "refused": "plan/qwen3-coder is on a connection for interactive use only: its provider's terms do not allow scheduled or background work. Choose a model on a pay-as-you-go connection."
      }
    },
    {
      "about": "A model the list does not have is not known to be one.",
      "kind": "scheduled",
      "model": "new/model",
      "models": [
        {
          "id": "plan/qwen3-coder",
          "interactive_only": true
        },
        {
          "id": "payg/qwen3-coder"
        },
        {
          "id": "deepseek/deepseek-flash"
        }
      ],
      "expect": {
        "run": true
      }
    }
  ]
}
